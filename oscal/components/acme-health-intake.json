    "components": [
      {
        "uuid": "d37a554c-4855-4cf7-bc26-e36fb952b3a1",
        "type": "service",
        "title": "Acme Health Patient Intake API",
        "description": "Telehealth patient intake service in AWS us-east-1: an API Gateway HTTP API invokes a Python Lambda in private subnets of the starter's VPC, which writes submissions to DynamoDB and attachments to S3. Wrapped with customer-managed KMS keys, an Object Lock evidence vault, a multi-region CloudTrail, and a GitHub Actions pipeline that plans, gates with OPA/Conftest, applies on merge, signs evidence with Cosign keyless and stores it in the vault. All infrastructure is defined in terraform/.",
        "props": [
          {
            "name": "repository",
            "ns": "https://github.com/yashduttsh-oss/cgep-app-starter/ns/oscal",
            "value": "https://github.com/yashduttsh-oss/cgep-app-starter"
          },
          {
            "name": "aws-region",
            "ns": "https://github.com/yashduttsh-oss/cgep-app-starter/ns/oscal",
            "value": "us-east-1"
          },
          {
            "name": "pipeline",
            "ns": "https://github.com/yashduttsh-oss/cgep-app-starter/ns/oscal",
            "value": ".github/workflows/grc-gate.yml"
          }
        ],
        "responsible-roles": [
          {
            "role-id": "provider",
            "party-uuids": [
              "be409350-871f-49ea-9651-f6c79d26dafe"
